---
// src/pages/raport/index.astro
import ReportLayout from "../layouts/ReportLayout.astro";

interface ReportData {
  slug: string;
  role: string;
  city: string;
  b2b: { min: number; max: number };
}

const reportFiles = import.meta.glob<{ default?: ReportData } | ReportData>(
  "../../data/reports/*.json",
  { eager: true }
);

const reports = Object.values(reportFiles).map((mod) => ('default' in mod ? mod.default! : mod));
---

<Layout title="Raporty Zarobków IT w Polsce">
  <main class="max-w-4xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold mb-6">Raporty Wynagrodzeń IT</h1>
    <div class="grid gap-4 md:grid-cols-2">
      {reports.map((report) => (
        <a 
          href={`/raport/${report.slug}`}
          class="block p-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg hover:border-indigo-500 transition shadow-sm"
        >
          <h2 class="font-bold text-lg text-slate-900 dark:text-slate-100">
            {report.role} w {report.city}
          </h2>
          <p class="text-sm text-slate-500 mt-1">
            B2B: {report.b2b.min.toLocaleString()} - {report.b2b.max.toLocaleString()} PLN
          </p>
        </a>
      ))}
    </div>
  </main>
</Layout>