---
import BaseLayout from '../../layouts/BaseLayout.astro';

interface ReportData {
  slug: string;
  role: string;
  city: string;
  b2b: { min: number; max: number };
}

const reportFiles = import.meta.glob<{ default?: ReportData } | ReportData>(
  '../../data/reports/*.json',
  { eager: true }
);

const reports = Object.values(reportFiles)
  .map((mod) => ('default' in mod ? mod.default! : mod as ReportData))
  .sort((a, b) => a.role.localeCompare(b.role));
---

<BaseLayout
  title="IT Salary Reports in Poland"
  description="Check current developer salaries in Polish cities. IT salary reports for B2B and employment contracts."
  lang="en"
  canonical="https://devsalaries.co/en/"
  urlPL="https://devsalaries.co/"
  urlEN="https://devsalaries.co/en/"
>
  <h1 class="text-3xl font-bold mb-2">IT Salary Reports in Poland</h1>
  <p class="text-slate-500 mb-8">Current salary data for {reports.length} roles and cities</p>
  <div class="grid gap-4 md:grid-cols-2">
    {reports.map((report) => (
      <a
        href={`/en/report/${report.slug}`}
        class="block p-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg hover:border-indigo-500 transition shadow-sm"
      >
        <h2 class="font-bold text-lg text-slate-900 dark:text-slate-100">
          {report.role} – {report.city}
        </h2>
        <p class="text-sm text-slate-500 mt-1">
          B2B: {report.b2b.min.toLocaleString('pl-PL')} – {report.b2b.max.toLocaleString('pl-PL')} PLN
        </p>
      </a>
    ))}
  </div>
</BaseLayout>
