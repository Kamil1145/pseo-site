---
// src/pages/raport/[slug].astro
import ReportLayout from "../../layouts/ReportLayout.astro";

export async function getStaticPaths() {
  // Dynamiczne importowanie wszystkich plików .json w folderze src/data/reports/
  const reportFiles = import.meta.glob<{ default: any }>("../../data/reports/*.json", { eager: true });

  return Object.entries(reportFiles).map(([path, module]) => {
    const report = module.default;
    
    // Jeśli plik nie ma pola 'slug', wyciągamy go z nazwy pliku
    const slug = report.slug || path.split("/").pop()?.replace(".json", "");

    return {
      params: { slug },
      props: { report },
    };
  });
}

const { report } = Astro.props;
---

<ReportLayout
  title={report.title}
  description={report.description}
  cityName={report.cityName}
  roleName={report.roleName}
  updatedAt={report.updatedAt}
>
  <div slot="summary" class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm">
    <p class="text-lg leading-relaxed text-slate-700 dark:text-slate-300">
      Na podstawie analizy <strong class="text-indigo-600 dark:text-indigo-400">{report.stats.sampleSize} zweryfikowanych ofert pracy</strong> oraz zgłoszeń z lokalnego rynku w mieście <strong>{report.cityName}</strong>, mediana wynagrodzenia dla roli <strong>{report.roleName}</strong> wynosi obecnie <strong>{report.stats.b2bMedian} na B2B</strong>.
    </p>
  </div>

  <div class="space-y-8">
    <section>
      <h2 class="text-2xl font-bold mb-4">Podsumowanie stawek (B2B vs UoP)</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse bg-white dark:bg-slate-900 rounded-lg overflow-hidden border border-slate-200 dark:border-slate-800">
          <thead class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
            <tr>
              <th class="p-3 border-b border-slate-200 dark:border-slate-700">Forma umowy</th>
              <th class="p-3 border-b border-slate-200 dark:border-slate-700">Mediana (50 percentile)</th>
              <th class="p-3 border-b border-slate-200 dark:border-slate-700">Typowe widełki (25-75 percentile)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 dark:divide-slate-800 text-sm">
            <tr>
              <td class="p-3 font-semibold text-slate-900 dark:text-slate-100">B2B (netto + VAT)</td>
              <td class="p-3 font-bold text-emerald-600 dark:text-emerald-400">{report.stats.b2bMedian}</td>
              <td class="p-3 text-slate-600 dark:text-slate-300">{report.stats.b2bRange}</td>
            </tr>
            <tr>
              <td class="p-3 font-semibold text-slate-900 dark:text-slate-100">Umowa o Pracę (brutto)</td>
              <td class="p-3 font-bold text-indigo-600 dark:text-indigo-400">{report.stats.uopMedian}</td>
              <td class="p-3 text-slate-600 dark:text-slate-300">{report.stats.uopRange}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2 class="text-2xl font-bold mb-3">Najczęściej wymagane technologie w {report.cityName}</h2>
      <div class="flex flex-wrap gap-2">
        {report.skills.map((skill: string) => (
          <span class="px-3 py-1 bg-slate-200 dark:bg-slate-800 text-slate-800 dark:text-slate-200 rounded-full text-sm font-medium">
            {skill}
          </span>
        ))}
      </div>
    </section>
  </div>

  <div slot="faq" class="space-y-6">
    <h2 class="text-2xl font-bold border-b border-slate-200 dark:border-slate-800 pb-2">Często zadawane pytania (FAQ)</h2>
    <div class="space-y-4">
      <details class="group bg-white dark:bg-slate-900 p-4 rounded-lg border border-slate-200 dark:border-slate-800">
        <summary class="font-semibold cursor-pointer list-none flex justify-between items-center">
          <span>Czy stawki B2B obejmują płatny urlop?</span>
          <span class="transition group-open:rotate-180">&darr;</span>
        </summary>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
          Około 65% ofert B2B dla stanowiska {report.roleName} w lokalizacji {report.cityName} oferuje płatne dni wolne (zazwyczaj 20-26 dni w roku) w ramach kontraktu.
        </p>
      </details>
    </div>
  </div>
</ReportLayout>