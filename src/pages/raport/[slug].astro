---
import { getCollection, type CollectionEntry } from 'astro:content';

// 1. Generowanie ścieżek statycznych dla wszystkich plików Markdown z kolekcji
export async function getStaticPaths() {
  const reports = await getCollection('city-reports');
  
  return reports.map((entry: CollectionEntry<'city-reports'>) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// 2. Jawna definicja typów dla właściwości (Props) przekazywanych do komponentu
interface Props {
  entry: CollectionEntry<'city-reports'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { data } = entry;

// 3. Przygotowanie danych strukturalnych JSON-LD pod Google Schema.org
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": data.title,
  "description": data.description,
  "dateModified": data.updatedAt,
  "author": {
    "@type": "Organization",
    "name": "Katalog Zarobków IT"
  },
  "about": {
    "@type": "Place",
    "name": data.city,
    "address": {
      "@type": "PostalAddress",
      "addressCountry": data.country
    }
  }
};
---

<!DOCTYPE html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{data.title}</title>
    <meta name="description" content={data.description} />

    {/* Automatyczne wstrzykiwanie danych strukturalnych JSON-LD dla Google */}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <style>
      body { 
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif; 
        max-width: 800px; 
        margin: 0 auto; 
        padding: 2rem; 
        line-height: 1.6; 
        color: #18181b; 
        background-color: #ffffff;
      }
      header {
        margin-bottom: 2rem;
      }
      header a {
        color: #2563eb;
        text-decoration: none;
        font-weight: 500;
      }
      header a:hover {
        text-decoration: underline;
      }
      .meta-box { 
        background: #f4f4f5; 
        border-radius: 8px; 
        padding: 1.25rem; 
        margin-bottom: 2rem; 
        border-left: 4px solid #2563eb; 
      }
      .meta-box p {
        margin: 0.4rem 0;
      }
      .ad-banner { 
        background: #fef3c7; 
        border: 1px dashed #d97706; 
        border-radius: 6px;
        padding: 1.25rem; 
        text-align: center; 
        margin: 2.5rem 0; 
        font-weight: 600; 
        color: #92400e;
      }
      main table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
      }
      main th, main td {
        border: 1px solid #e4e4e7;
        padding: 0.75rem;
        text-align: left;
      }
      main th {
        background-color: #f4f4f5;
      }
    </style>
  </head>
  <body>
    <header>
      <a href="/">← Powrót do katalogu głównego</a>
    </header>

    <main>
      <!-- Pasek Meta z danymi strukturalnymi z Frontmattera -->
      <div class="meta-box">
        <p><strong>Lokalizacja:</strong> {data.city}, {data.country}</p>
        <p><strong>Średnie wynagrodzenie:</strong> ${data.avg_salary_usd} USD / mies.</p>
        <p><small>Ostatnia aktualizacja: {data.updatedAt}</small></p>
      </div>

      <!-- Wyrenderowana treść Markdown -->
      <Content />

      <!-- MONETYZACJA: Miejsce na baner reklamowy lub link afiliacyjny -->
      <div class="ad-banner">
        <span>Pracujesz zdalnie z {data.country}? Sprawdź zalecane konta wielowalutowe i rozwiązania B2B.</span>
      </div>
    </main>
  </body>
</html>