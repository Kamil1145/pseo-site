---
// src/pages/raport/[slug].astro
import ReportLayout from "../../layouts/ReportLayout.astro";

export interface ReportData {
  slug: string;
  role: string;
  city: string;
  updatedAt: string;
  b2b: {
    min: number;
    max: number;
  };
  uop: {
    min: number;
    max: number;
  };
  seoDescription: string;
}

export async function getStaticPaths() {
  // Czyste typowanie odporne na parser Astro
  const reportFiles = import.meta.glob<Record<string, any>>(
    "../../data/reports/*.json",
    { eager: true }
  );

  return Object.entries(reportFiles).map(([filePath, module]) => {
    const reportData = (module && "default" in module ? module.default : module) as ReportData;
    const fallbackSlug = filePath.split("/").pop()?.replace(".json", "") || "";
    const slug = reportData?.slug || fallbackSlug;

    return {
      params: { slug },
      props: { report: reportData },
    };
  });
}

interface Props {
  report: ReportData;
}

const { report } = Astro.props;

if (!report) {
  throw new Error("Nie znaleziono danych dla raportu.");
}

// Formatowanie kwot i obliczanie mediany
const formatPLN = (val: number) => `${val.toLocaleString("pl-PL")} PLN`;
const calculateMedian = (min: number, max: number) => formatPLN(Math.round((min + max) / 2));

const b2bMedianFormatted = calculateMedian(report.b2b.min, report.b2b.max);
const b2bRangeFormatted = `${formatPLN(report.b2b.min)} - ${formatPLN(report.b2b.max)} + VAT`;

const uopMedianFormatted = calculateMedian(report.uop.min, report.uop.max);
const uopRangeFormatted = `${formatPLN(report.uop.min)} - ${formatPLN(report.uop.max)} brutto`;

const pageTitle = `Zarobki ${report.role} w ${report.city} (${report.updatedAt})`;

// Obiekt danych strukturalnych JSON-LD
const jsonLdData = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": pageTitle,
  "description": report.seoDescription,
  "dateModified": report.updatedAt,
  "author": {
    "@type": "Organization",
    "name": "Twoja Marka IT"
  }
};
---

<ReportLayout
  title={pageTitle}
  description={report.seoDescription}
  cityName={report.city}
  roleName={report.role}
  updatedAt={report.updatedAt}
>
  <!-- Dane strukturalne Schema.org pod SEO -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLdData)} />

  <!-- Podsumowanie raportu -->
  <div slot="summary" class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm">
    <p class="text-lg leading-relaxed text-slate-700 dark:text-slate-300">
      Na podstawie aktualnych danych z lokalnego rynku w mieście <strong>{report.city}</strong>, szacowana mediana wynagrodzenia dla roli <strong>{report.role}</strong> wynosi obecnie <strong>{b2bMedianFormatted} na B2B</strong>.
    </p>
  </div>

  <!-- Główna zawartość: Stawki -->
  <div class="space-y-8">
    <section>
      <h2 class="text-2xl font-bold mb-4">Podsumowanie stawek (B2B vs UoP)</h2>
      
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse bg-white dark:bg-slate-900 rounded-lg overflow-hidden border border-slate-200 dark:border-slate-800">
          <thead class="bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
            <tr>
              <th class="p-3 border-b border-slate-200 dark:border-slate-700">Forma umowy</th>
              <th class="p-3 border-b border-slate-200 dark:border-slate-700">Szacowana mediana</th>
              <th class="p-3 border-b border-slate-200 dark:border-slate-700">Widełki płacowe (Min - Max)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 dark:divide-slate-800 text-sm">
            <tr>
              <td class="p-3 font-semibold text-slate-900 dark:text-slate-100">B2B (netto + VAT)</td>
              <td class="p-3 font-bold text-emerald-600 dark:text-emerald-400">{b2bMedianFormatted}</td>
              <td class="p-3 text-slate-600 dark:text-slate-300">{b2bRangeFormatted}</td>
            </tr>
            <tr>
              <td class="p-3 font-semibold text-slate-900 dark:text-slate-100">Umowa o Pracę (brutto)</td>
              <td class="p-3 font-bold text-indigo-600 dark:text-indigo-400">{uopMedianFormatted}</td>
              <td class="p-3 text-slate-600 dark:text-slate-300">{uopRangeFormatted}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <!-- Sekcja FAQ -->
  <div slot="faq" class="space-y-6">
    <h2 class="text-2xl font-bold border-b border-slate-200 dark:border-slate-800 pb-2">Często zadawane pytania (FAQ)</h2>
    
    <div class="space-y-4">
      <details class="group bg-white dark:bg-slate-900 p-4 rounded-lg border border-slate-200 dark:border-slate-800">
        <summary class="font-semibold cursor-pointer list-none flex justify-between items-center">
          <span>Czy stawki B2B dla {report.role} w {report.city} obejmują płatny urlop?</span>
          <span class="transition group-open:rotate-180">&darr;</span>
        </summary>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
          Większość kontraktów B2B na tym stanowisku w tym regionie nie zawiera wbudowanego płatnego urlopu, jednak część firm oferuje pakiety z 20-26 dniami płatnymi w roku kosztem minimalnie niższej stawki godzinowej.
        </p>
      </details>
    </div>
  </div>
</ReportLayout>