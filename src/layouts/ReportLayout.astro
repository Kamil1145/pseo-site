---
// src/layouts/ReportLayout.astro
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  cityName: string;
  roleName: string;
  lang?: 'pl' | 'en';
  slug?: string;
  minSalary?: number;
  maxSalary?: number;
  currency?: string;
  updatedAt?: string;
}

const { 
  title, 
  description, 
  cityName, 
  roleName, 
  lang = 'pl',
  slug = Astro.params.slug as string,
  minSalary,
  maxSalary,
  currency = 'PLN',
  updatedAt = new Date().toISOString().split('T')[0] 
} = Astro.props;

// Konfiguracja URL dla wersji i18n
const baseUrl = Astro.site?.origin || 'https://devsalaries.co';
const pathPL = `/raport/${slug}/`;
const pathEN = `/en/report/${slug}/`;

const urlPL = new URL(pathPL, baseUrl).href;
const urlEN = new URL(pathEN, baseUrl).href;

// Rejestracja canonical URL dopasowana do obecnego języka
const canonicalURL = lang === 'en' ? urlEN : urlPL;
const ogImageUrl = new URL(`/og/${slug}.png`, baseUrl).href;

// Teksty statyczne w zależności od języka layoutu
const t = {
  pl: {
    lastUpdated: "Ostatnia aktualizacja danych:",
    location: "Lokalizacja:",
    navReports: "Raporty wynagrodzeń",
    affiliateTag: "Dla samozatrudnionych B2B",
    affiliateTitle: `Rozliczasz kontrakt w ${cityName}?`,
    affiliateDesc: 'Oblicz dokładny zysk "na rękę" po odliczeniu ryczałtu/liniowego oraz kosztów księgowości.',
    affiliateBtn: "Sprawdź kalkulator B2B →",
    disclaimer: `* Raporty generowane są na podstawie zagregowanych i anonimowych ofert pracy oraz zgłoszeń społeczności dla roli ${roleName}. Niektóre odnośniki w serwisie mają charakter partnerski (afiliacyjny) – skorzystanie z nich może przynieść serwisowi prowizję bez ponoszenia dodatkowych kosztów przez Ciebie.`,
    copyright: "Wszystkie prawa zastrzeżone."
  },
  en: {
    lastUpdated: "Data last updated:",
    location: "Location:",
    navReports: "Salary Reports",
    affiliateTag: "For B2B Contractors",
    affiliateTitle: `Contracting in ${cityName}?`,
    affiliateDesc: "Calculate your net take-home pay after tax deductions and accounting expenses.",
    affiliateBtn: "Check B2B Calculator →",
    disclaimer: `* Reports are generated based on aggregated job offerings and community submissions for ${roleName}. Some links may contain affiliate referrals providing commissions at no extra cost to you.`,
    copyright: "All rights reserved."
  }
}[lang];

// Dane strukturalne Schema.org (BreadcrumbList + Occupation/Article)
const breadcrumbsJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "DevSalaries",
      "item": baseUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": cityName,
      "item": canonicalURL
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": roleName,
      "item": canonicalURL
    }
  ]
};

const occupationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Occupation",
  "name": roleName,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL
  },
  "description": description,
  "estimatedSalary": minSalary && maxSalary ? [
    {
      "@type": "MonetaryAmountDistribution",
      "name": "Base Salary Range",
      "currency": currency,
      "duration": "MONTH",
      "percentile10": minSalary,
      "percentile90": maxSalary
    }
  ] : undefined,
  "occupationLocation": [
    {
      "@type": "City",
      "name": cityName
    }
  ]
};
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <!-- Podstawowe meta tagi -->
  <title>{title} | DevSalaries.co</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  
  <!-- Tagi powiązań językowych i18n (hreflang) -->
  <link rel="alternate" hreflang="pl" href={urlPL} />
  <link rel="alternate" hreflang="en" href={urlEN} />
  <link rel="alternate" hreflang="x-default" href={urlPL} />

  <!-- Open Graph / Facebook / LinkedIn -->
  <meta property="og:type" content="article" />
  <meta property="og:locale" content={lang === 'pl' ? 'pl_PL' : 'en_US'} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalURL} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <!-- Preconnect dla wydań wydajnościowych (Core Web Vitals) -->
  <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
  
  <!-- Google AdSense -->
  <script 
    async 
    src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX" 
    crossorigin="anonymous">
  </script>

  <!-- Dane strukturalne Schema.org -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(occupationJsonLd)} />
</head>

<body class="bg-slate-50 text-slate-900 antialiased min-h-screen flex flex-col dark:bg-slate-950 dark:text-slate-100">
  
  <!-- Nawigacja / Nagłówek -->
  <header class="border-b border-slate-200 bg-white dark:bg-slate-900 dark:border-slate-800">
    <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between">
      <a href={lang === 'en' ? '/en/' : '/'} class="font-bold text-xl tracking-tight text-indigo-600 dark:text-indigo-400">
        devsalaries<span class="text-slate-400">.co</span>
      </a>
      <nav aria-label="Główna nawigacja" class="flex items-center gap-4 text-sm font-medium text-slate-600 dark:text-slate-400">
        <a href={lang === 'en' ? '/en/' : '/'} class="hover:text-indigo-600 transition-colors">
          {t.navReports}
        </a>
        
        <!-- Przełącznik języka -->
        <div class="flex items-center gap-1.5 pl-2 border-l border-slate-200 dark:border-slate-700 text-xs font-semibold">
          <a href={urlPL} class={`px-1.5 py-0.5 rounded ${lang === 'pl' ? 'bg-indigo-100 text-indigo-700 dark:bg-indigo-900/60 dark:text-indigo-300' : 'hover:text-indigo-600'}`}>PL</a>
          <a href={urlEN} class={`px-1.5 py-0.5 rounded ${lang === 'en' ? 'bg-indigo-100 text-indigo-700 dark:bg-indigo-900/60 dark:text-indigo-300' : 'hover:text-indigo-600'}`}>EN</a>
        </div>
      </nav>
    </div>
  </header>

  <!-- Główna zawartość strony -->
  <main class="flex-grow max-w-4xl w-full mx-auto px-4 py-8">
    
    <!-- Sekcja H1 i metadane -->
    <header class="mb-6">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-3">
        {title}
      </h1>
      <p class="text-sm text-slate-500 dark:text-slate-400">
        {t.lastUpdated} <time datetime={updatedAt}>{updatedAt}</time> &bull; {t.location} <span class="font-semibold text-slate-700 dark:text-slate-300">{cityName}</span>
      </p>
    </header>

    <!-- Krótkie wprowadzenie / Wartość unikalna -->
    <section class="prose dark:prose-invert max-w-none mb-6">
      <slot name="summary" />
    </section>

    <!-- REKLAMA #1: Top In-Article -->
    <div aria-label="Reklama" class="ad-container my-6 text-center min-h-[280px] bg-slate-100 dark:bg-slate-900 rounded-lg flex items-center justify-center p-2">
      <ins class="adsbygoogle"
           style="display:block; text-align:center;"
           data-ad-layout="in-article"
           data-ad-format="fluid"
           data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
           data-ad-slot="1111111111"></ins>
      <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </div>

    <!-- Główna treść raportu -->
    <article class="prose dark:prose-invert max-w-none my-8">
      <slot />
    </article>

    <!-- WIDGET AFILIACYJNY B2B / Księgowość -->
    <aside class="my-8 p-6 bg-gradient-to-r from-indigo-50 to-blue-50 dark:from-slate-900 dark:to-indigo-950/40 rounded-xl border border-indigo-100 dark:border-indigo-900/50">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">{t.affiliateTag}</span>
          <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100 mt-1">{t.affiliateTitle}</h3>
          <p class="text-sm text-slate-600 dark:text-slate-300 mt-1">
            {t.affiliateDesc}
          </p>
        </div>
        <a 
          href="https://example.com/affiliate-link" 
          target="_blank" 
          rel="sponsored nofollow" 
          class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm rounded-lg transition-colors shadow-sm whitespace-nowrap"
        >
          {t.affiliateBtn}
        </a>
      </div>
    </aside>

    <!-- REKLAMA #2: Mid Content -->
    <div aria-label="Reklama" class="ad-container my-8 text-center min-h-[250px] bg-slate-100 dark:bg-slate-900 rounded-lg flex items-center justify-center p-2">
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
           data-ad-slot="2222222222"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
      <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </div>

    <!-- Sekcja dolna (FAQ / Porównania) -->
    <section class="prose dark:prose-invert max-w-none my-8">
      <slot name="faq" />
    </section>

    <!-- Informacja o zastrzeżeniach / Afiliacji -->
    <p class="text-xs text-slate-400 dark:text-slate-500 mt-12 border-t border-slate-200 dark:border-slate-800 pt-4">
      {t.disclaimer}
    </p>

  </main>

  <!-- Stopka -->
  <footer class="border-t border-slate-200 bg-white dark:bg-slate-900 dark:border-slate-800 py-6 mt-12">
    <div class="max-w-5xl mx-auto px-4 text-center text-xs text-slate-500 dark:text-slate-400">
      <p>&copy; {new Date().getFullYear()} devsalaries.co &bull; {t.copyright}</p>
    </div>
  </footer>

</body>
</html>